generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "sqlite"
}

/// A registered user. Password is hashed with bcrypt. Optional fields
/// support social login profiles (name, image from OAuth providers).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  passwordHash  String?
  emailVerified DateTime?
  // Application role: FREE is the default; active Stripe subscriptions are
  // synchronized to PRO. ADMIN is reserved for operator-managed accounts.
  // SQLite has no native enum support, so lib/roles.ts validates this value at
  // every application boundary.
  role          String    @default("FREE")
  // SaaS plan: "free" | "pro". Set via the Stripe billing webhook when the
  // user completes checkout / updates their subscription (see lib/billing).
  plan                    String   @default("free")
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  // Daily LLM usage counter — the free tier caps requests per day; the Pro
  // tier is unlimited (see lib/billing/plans.ts + the /api/chat route).
  usageCount              Int      @default(0)
  usageTokens             Int      @default(0)
  usageDate               String?
  createdAt               DateTime @default(now())
  accounts                Account[]
  sessions                Session[]
  preference              UserPreference?
  passwordResetTokens     PasswordResetToken[]
  memoryRecords           MemoryRecord[]
  customAgents             CustomAgent[]
  workspaceTasks           WorkspaceTask[]

  @@map("users")
}

/// OAuth / Credentials account linked to a user.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

/// Active sessions for session-based auth.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

/// An anonymous chat session. One thread of conversation history per session.
/// `title` is an optional user-renamed sidebar label; when null, the sidebar
/// derives the title from the first message.
model ChatSession {
  id            String        @id @default(cuid())
  userId        String?
  title         String?
  systemPrompt  String?
  // Comma-separated skill ids active for this session. Null = defaults
  // (SKILLS_ENABLED env or the full catalog); empty string = none enabled.
  enabledSkills  String?
  customAgentId  String?
  customAgent    CustomAgent? @relation(fields: [customAgentId], references: [id], onDelete: SetNull)
  pinned         Boolean       @default(false)
  archived      Boolean       @default(false)
  // Index of the previously active branch, restored on session reload.
  activeBranch  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]
  documents     Document[]

  @@index([userId])
  @@map("chat_sessions")
}

/// One message in a session's thread. The id is client-generated (UUID) so
/// saving a thread is idempotent — re-saving the same message updates rather
/// than duplicates. `position` preserves client-side thread order (multiple
/// messages can share a createdAt within one save transaction, so timestamp
/// ordering alone is not deterministic). `role` is a string because SQLite
/// has no enums; it is validated against user/assistant in the server action
/// layer (zod).
model ChatMessage {
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  position  Int
  // Which provider model served this message, stamped client-side from the
  // route's X-Served-Model header (NULL for messages that predate the field).
  model           String?
  // True when the served model differed from the user's selection (error
  // fallback retry or vision auto-routing) — drives the amber warning caption.
  modelOverridden Boolean?
  // The branch this message belongs to ("0", "1", …) — branch order is the
  // index, and `position` orders within a branch. Together they persist the
  // conversation's forked branches across session switches.
  branchId  String      @default("0")
  id        String
  createdAt DateTime    @default(now())

  // A message may appear in several branches (the shared prefix of a fork), so
  // the row identity is (sessionId, branchId, id) — one row per branch.
  // `id` remains the client-generated message id/React key within a branch.
  @@id([sessionId, branchId, id])
  @@index([sessionId, branchId, position])
  @@map("chat_messages")
}

/// An uploaded document whose extracted text is available to the session's RAG pipeline.
/// A user-owned custom assistant with a dynamic system prompt, optional
/// baseline model, and selected tool ids. Tool configuration is JSON so the UI
/// can evolve without exposing arbitrary server capabilities.
model CustomAgent {
  id            String        @id @default(cuid())
  userId        String
  name          String
  description   String?
  systemPrompt  String
  baselineModel String?
  selectedTools String        @default("[]")
  // Optional visual accent for the chat shell; validated by the action layer.
  theme         String?
  createdAt     DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     ChatSession[]

  @@index([userId, updatedAt])
  @@map("custom_agents")
}

model Document {
  id          String          @id @default(cuid())
  sessionId   String
  session     ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name        String
  mimeType    String
  size        Int
  textLength  Int
  createdAt   DateTime        @default(now())
  chunks      DocumentChunk[]

  @@index([sessionId, createdAt])
  @@map("documents")
}

/// A bounded text chunk and its vector embedding, serialized for SQLite.
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String
  embedding  String

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

/// Per-user preferences: display name, avatar URL, personal API key,
/// custom system prompt presets stored as JSON, the Google Calendar
/// service-account key (JSON) used by the schedule_block skill tool, the
/// preferred default model (UI model key, see lib/models.ts), and generation
/// tuning (temperature + max completion tokens) applied to chat requests.
model UserPreference {
  id                        String  @id @default(cuid())
  userId                    String  @unique
  displayName               String?
  avatarUrl                 String?
  apiKey                    String?
  systemPromptPresets       String  @default("[]")
  googleCalendarId          String?
  googleServiceAccountKey   String?
  // UI model key from lib/models.ts (e.g. "qwen-3-6"); null = provider default.
  preferredModel            String?
  temperature               Float?
  maxCompletionTokens       Int?
  // Per-message "via <model>" captions in the thread (default: shown).
  showModelCaptions         Boolean @default(true)
  activeWorkspaceTaskId     String?
  user                      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

/// A user-owned workspace task shown above the conversation list.
model WorkspaceTask {
  id        String   @id @default(cuid())
  userId    String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("workspace_tasks")
}

/// Long-term user memory, scoped by category and optional source session.
model MemoryRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  key         String
  value       String
  sessionId   String?
  confidence  Float    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, key])
  @@index([userId, category, updatedAt])
  @@map("memory_records")
}

/// Single-use password reset token. `tokenHash` is SHA-256 of the raw token
/// sent in the email link — the raw value is never stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
