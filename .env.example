# --- LLM provider: OpenRouter (https://openrouter.ai/keys) ---
# OpenAI-compatible endpoint; one key unlocks 200+ models, including free
# models (e.g. meta-llama/llama-3.3-70b-instruct:free). Copy this file to
# .env.local and set the key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional (defaults shown)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=stealth/ox-alpha
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_APP_NAME=Chatbot
# Optional: model used by the /api/transcribe server-side speech-to-text route
# (composer mic fallback on browsers without the Web Speech API). Defaults to
# whisper-1; pick a model your provider exposes under /audio/transcriptions.
# TRANSCRIBE_MODEL=whisper-1

# Optional overrides for the model selector's provider model ids:
# MODEL_QWEN_3_6=qwen/qwen3.5-397b-a17b
# MODEL_DEEPSEEK_V4_FLASH=deepseek/deepseek-v4-flash
# MODEL_KIMI_K3=moonshotai/kimi-k3
# MODEL_GPT_5_6=openai/gpt-5.6

# For any other OpenAI-compatible endpoint (OpenAI, Groq, Together, Ollama…)
# set OPENAI_API_KEY and, if needed, OPENAI_BASE_URL + OPENAI_MODEL.

# --- MCP agent tools (optional) ---
# JSON array of Streamable HTTP MCP servers. Keep credentials in server-side
# headers and never expose this value to client code.
# MCP_SERVERS_JSON='[{"id":"weather","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer ..."}}]'

# Optional built-in web search adapter. The agent returns a marked mock result
# when these are unset.
# WEB_SEARCH_URL=https://search-provider.example/api/search
# WEB_SEARCH_API_KEY=your-search-provider-key

# Optional weather adapter (same pattern as web search).
# WEATHER_API_URL=https://weather-provider.example/api/weather
# WEATHER_API_KEY=your-weather-provider-key

# --- Skill tool providers (optional; unset ⇒ graceful local fallbacks) ---
# diagram_render: any Kroki-compatible service (defaults to https://kroki.io).
# DIAGRAM_RENDER_URL=https://kroki.io
# DIAGRAM_RENDER_API_KEY=your-kroki-token

# schedule_block: Google Calendar via a service account. Create a service
# account in Google Cloud, enable the Calendar API, and share a calendar with
# the service account email. These env vars configure the server-wide default;
# signed-in users can instead paste their own service-account key JSON + calendar
# id in Settings (stored per-user, takes precedence over these vars).
# The private key can be the PEM or base64-encoded PEM.
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-bot@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...

# --- Live provider integration tests (manual, skipped in CI) ---
# Run tests/live-providers.test.ts against the real Kroki service and a
# sandbox Google Calendar (requires the GOOGLE_* vars above):
# RUN_LIVE_PROVIDER_TESTS=true npx vitest run tests/live-providers.test.ts

# --- Context compression (FR-3 optimization) ---
# Optional: history sent to the LLM is truncated to the last N messages and
# dropped until the estimated token budget fits (defaults: 20 / 8000). The
# system prompt and retrieved document context are reserved before history.
# MAX_HISTORY_MESSAGES=20
# MAX_CONTEXT_TOKENS=8000

# --- Conversation history database (FR-11) ---
# SQLite via LibSQL (WASM, no native build tools needed). For production,
# point this at a hosted LibSQL/Turso URL or a Postgres-compatible service
# (requires swapping the Prisma datasource provider + driver adapter).
DATABASE_URL="file:./prisma/dev.db"

# --- Authentication (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=your-secret-here

# Google OAuth (optional — uncomment Google provider in lib/auth.ts)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (optional — uncomment GitHub provider in lib/auth.ts)
# GITHUB_ID=your-github-client-id
# GITHUB_SECRET=your-github-client-secret

# Set to true to bypass auth entirely (useful for e2e tests and local dev
# before OAuth credentials are configured).
# AUTH_DISABLED=true

# Required in production — tells NextAuth to trust the Host header.
AUTH_TRUST_HOST=true

# --- SaaS billing (Stripe; optional) ---
# When unset, billing is disabled: /api/chat enforces no plan caps, the
# settings Plan & Billing section hides, and /api/webhooks/stripe returns 501.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO=price_xxx
# Free-tier daily LLM request cap (default 20). Pro is unlimited.
# FREE_PLAN_DAILY_LIMIT=20

# --- Rate limiting / cost control (optional overrides) ---
# Per-minute caps per user/IP on the LLM-facing endpoints. Defaults below.
# CHAT_RATE_LIMIT=120
# TRANSCRIBE_RATE_LIMIT=60
# UPLOAD_RATE_LIMIT=60

# Rate-limit buckets live in-memory by default (per process). Point this at a
# Redis to share limits across instances and survive restarts: any Redis-
# compatible service works (Upstash, Redis Cloud, ElastiCache, Valkey/
# Dragonfly, self-hosted) — redis://, rediss:// (TLS), or a Unix socket.
# Unset ⇒ the in-memory fallback is used.
# REDIS_URL=redis://user:password@host:6379

# --- Analytics (optional; off by default — the app never phones home) ---
# PostHog capture (events are forwarded server-side, key never hits the
# browser), or ANALYTICS_DEBUG=true to log events to the server console.
# POSTHOG_API_KEY=phc_xxx
# POSTHOG_HOST=https://us.i.posthog.com
# ANALYTICS_DEBUG=true

# --- App identity (SEO/metadata + Stripe return URLs) ---
# APP_NAME=Chatbot
# NEXT_PUBLIC_APP_URL=http://localhost:3000
