# --- LLM provider: OpenRouter (https://openrouter.ai/keys) ---
# OpenAI-compatible endpoint; one key unlocks 200+ models, including free
# models (e.g. meta-llama/llama-3.3-70b-instruct:free). Copy this file to
# .env.local and set the key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional (defaults shown)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=deepseek/deepseek-chat
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENROUTER_APP_NAME=Pulse AI
# Optional: model used by the /api/transcribe server-side speech-to-text route
# (composer mic fallback on browsers without the Web Speech API). Defaults to
# whisper-1; pick a model your provider exposes under /audio/transcriptions.
# TRANSCRIBE_MODEL=whisper-1
# Optional TTS adapter used by assistant speaker buttons. Browser SpeechSynthesis
# remains the fallback when this is unset or unavailable.
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy

# Optional overrides for the model selector's provider model ids:
# MODEL_QWEN_3_6=qwen/qwen3.5-397b-a17b
# MODEL_DEEPSEEK_V4_FLASH=deepseek/deepseek-v4-flash
# Kimi K3's verified OpenRouter slug (paid; 404/402/429 retries use FALLBACK_MODEL)
# MODEL_KIMI_K3=moonshotai/kimi-k3
# MODEL_GPT_5_6=openai/gpt-5.6
# MODEL_GEMINI_2_FLASH=google/gemini-2.5-flash-lite

# Error-fallback models used to retry 404/402/429 failures per provider
# (the "Provider default" selection on OpenRouter also uses FALLBACK_MODEL).
# Defaults: free stealth/ox-alpha (OpenRouter), gemini-2.5-flash-lite (direct
# Gemini), gpt-4o-mini (OpenAI). Override to pin a different backup.
# FALLBACK_MODEL=stealth/ox-alpha
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# --- Alternative LLM provider: Google Gemini (https://aistudio.google.com/apikey) ---
# Direct OpenAI-compatible endpoint with a generous free tier (e.g.
# gemini-2.0-flash). Used when OPENROUTER_API_KEY is unset; the model selector's
# "Gemini 2.0 Flash" option then sends the plain model name. Signed-in users can
# instead paste their own key in Settings (stored per-user, takes precedence
# over all of these env vars).
# GEMINI_API_KEY=AIza...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# For any other OpenAI-compatible endpoint (OpenAI, Groq, Together, Ollama…)
# set OPENAI_API_KEY and, if needed, OPENAI_BASE_URL + OPENAI_MODEL.

# --- MCP agent tools (optional) ---
# JSON array of Streamable HTTP MCP servers. Keep credentials in server-side
# headers and never expose this value to client code.
# MCP_SERVERS_JSON='[{"id":"weather","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer ..."}}]'

# Optional built-in web search adapter. The agent returns a marked mock result
# when these are unset.
# WEB_SEARCH_URL=https://search-provider.example/api/search
# WEB_SEARCH_API_KEY=your-search-provider-key

# Optional weather adapter (same pattern as web search).
# WEATHER_API_URL=https://weather-provider.example/api/weather
# WEATHER_API_KEY=your-weather-provider-key

# --- Skill tool providers (optional; unset ⇒ graceful local fallbacks) ---
# diagram_render: any Kroki-compatible service (defaults to https://kroki.io).
# DIAGRAM_RENDER_URL=https://kroki.io
# DIAGRAM_RENDER_API_KEY=your-kroki-token

# schedule_block: Google Calendar via a service account. Create a service
# account in Google Cloud, enable the Calendar API, and share a calendar with
# the service account email. These env vars configure the server-wide default;
# signed-in users can instead paste their own service-account key JSON + calendar
# id in Settings (stored per-user, takes precedence over these vars).
# The private key can be the PEM or base64-encoded PEM.
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-bot@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...

# --- Live provider integration tests (manual, skipped in CI) ---
# Run tests/live-providers.test.ts against the real Kroki service and a
# sandbox Google Calendar (requires the GOOGLE_* vars above):
# RUN_LIVE_PROVIDER_TESTS=true npx vitest run tests/live-providers.test.ts

# --- Context compression (FR-3 optimization) ---
# Optional: history sent to the LLM is truncated to the last N messages and
# dropped until the estimated token budget fits (defaults: 20 / 8000). The
# system prompt and retrieved document context are reserved before history.
# MAX_HISTORY_MESSAGES=20
# MAX_CONTEXT_TOKENS=8000

# Completion-length cap sent as max_tokens to every provider (OpenRouter
# included) when the client doesn't specify one. The tiny default keeps
# OpenRouter's pre-authorization cost near zero — omitting the field makes it
# pre-authorize against the model max (~16k) and 402 low-credit keys before a
# token streams (verified live; see lib/llm-config.ts resolveMaxTokens). The
# per-user settings slider overrides this when set. Default 200.
# MAX_OUTPUT_TOKENS=200

# --- Conversation history database (FR-11) ---
# SQLite via LibSQL (WASM, no native build tools needed). For production,
# point this at a hosted LibSQL/Turso URL or a Postgres-compatible service
# (requires swapping the Prisma datasource provider + driver adapter).
DATABASE_URL="file:./prisma/dev.db"

# --- Authentication (NextAuth v5) ---
# Generate with: npx auth secret
AUTH_SECRET=your-secret-here

# Google OAuth. In local development, DEV_OAUTH_MOCK=true exposes the
# buttons with placeholder credentials until you register a real OAuth app.
# Placeholder values are UI scaffolding only; clicking them cannot complete
# OAuth until replaced with credentials from Google/GitHub.
DEV_OAUTH_MOCK=true
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret
# Auth.js aliases AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET are also accepted.

# GitHub OAuth (local mock fallback; replace both values for real sign-in)
GITHUB_ID=mock-github-client-id
GITHUB_SECRET=mock-github-client-secret
# Auth.js aliases AUTH_GITHUB_ID / AUTH_GITHUB_SECRET are also accepted.
# Register callbacks at /api/auth/callback/google and /api/auth/callback/github.
# Set DEV_OAUTH_MOCK=false when you want missing credentials to hide the buttons.

# Set to true to bypass auth entirely (useful for e2e tests and local dev
# before OAuth credentials are configured).
# AUTH_DISABLED=true

# Required in production — tells NextAuth to trust the Host header.
AUTH_TRUST_HOST=true

# --- Data-at-rest encryption (recommended in production) ---
# Encrypts sensitive UserPreference fields at rest (the user's API key and
# Google service-account private key) with AES-256-GCM. Any string works
# (sha256-derived to a 256-bit key); generate one with e.g.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Set it ONCE and keep it stable — changing it makes previously encrypted
# fields undecryptable (they degrade to empty, not garbage). When unset,
# sensitive fields are stored in plaintext with a startup warning.
# ENCRYPTION_KEY=your-long-random-secret

# --- SaaS billing (Stripe; optional) ---
# When unset, billing is disabled: /api/chat enforces no plan caps, the
# settings Plan & Billing section shows configuration errors, and
# /api/webhooks/stripe returns 501. Checkout/portal server actions are
# authenticated and rate-limited; webhook requests require a valid signature.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO=price_xxx
# Free-tier daily LLM request cap (default 20). Pro is unlimited.
# FREE_PLAN_DAILY_LIMIT=20

# --- Rate limiting / cost control (optional overrides) ---
# Per-minute caps per user/IP on the LLM-facing endpoints. Defaults below.
# CHAT_RATE_LIMIT=120
# TRANSCRIBE_RATE_LIMIT=60
# UPLOAD_RATE_LIMIT=60

# Rate-limit buckets live in-memory by default (per process). Point this at a
# Redis to share limits across instances and survive restarts: any Redis-
# compatible service works (Upstash, Redis Cloud, ElastiCache, Valkey/
# Dragonfly, self-hosted) — redis://, rediss:// (TLS), or a Unix socket.
# Unset ⇒ the in-memory fallback is used.
# REDIS_URL=redis://user:password@host:6379
#
# --- Background task worker (BullMQ, optional) ---
# When REDIS_URL is set, heavy tasks (document processing, webhook
# side-effects) are dispatched to a BullMQ queue and processed
# asynchronously. Run the worker alongside the app server:
#   WORKER_MODE=true node scripts/worker.mjs
# Or add to package.json: "worker": "WORKER_MODE=true node scripts/worker.mjs"

# --- Transactional email (optional) ---
# Resend is preferred when both providers are configured; SendGrid is used
# otherwise. Without either key, local development logs a short email preview
# and production safely skips delivery. Never expose these keys to the client.
# RESEND_API_KEY=re_xxx
# RESEND_EMAIL_FROM=Pulse AI <noreply@yourdomain.com>
# SENDGRID_API_KEY=SG.xxx
# SENDGRID_EMAIL_FROM=notifications@yourdomain.com
# EMAIL_FROM=notifications@yourdomain.com

# --- Analytics (optional; off by default — the app never phones home) ---
# PostHog capture (events are forwarded server-side, key never hits the
# browser), or ANALYTICS_DEBUG=true to log events to the server console.
# POSTHOG_API_KEY=phc_xxx
# POSTHOG_HOST=https://us.i.posthog.com
# ANALYTICS_DEBUG=true

# --- App identity (SEO/metadata + Stripe return URLs + CSRF origin guard) ---
# APP_NAME=Pulse AI
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# IMPORTANT (Vercel/production): set this to the deployed URL so the CSRF
# origin guard in `lib/security.ts` accepts same-origin POSTs from the
# browser. Without it the check falls back to the request's own host, which
# works but means the guard's behaviour is environment-dependent — set it
# explicitly to make the production CSRF check deterministic.
# NEXT_PUBLIC_APP_URL=https://ai-chatbot-rose-ten.vercel.app
#
# --- Auth.js v5 URL ---
# AUTH_URL takes priority over NEXT_PUBLIC_APP_URL inside Auth.js itself
# (it controls where NextAuth's OAuth callbacks point and how the secure
# session cookie is scoped). Set both to the same value to keep them in
# sync. AUTH_URL is what Auth.js v5 reads; NEXTAUTH_URL is the v4 alias,
# still respected as a fallback by some tooling.
# AUTH_URL=https://ai-chatbot-rose-ten.vercel.app
# NEXTAUTH_URL=https://ai-chatbot-rose-ten.vercel.app
#
# --- Auth.js secret ---
# Required by NextAuth v5 to sign the JWT session cookie. Generate with:
#   npx auth secret
# MUST be set in production; without it Auth.js falls back to an
# ephemeral key that rotates on every cold start, signing every user out.
# AUTH_SECRET=replace-with-output-of-npx-auth-secret
# --- Trust the deployment host (Vercel proxy) ---
# Auth.js v5 reads x-forwarded-host / x-forwarded-proto to derive the
# request URL behind a proxy. trustHost: true is already hardcoded in
# lib/auth.ts (commit 2e86936) so the AUTH_TRUST_HOST env var is no longer
# needed, but keep this note here as a hint for anyone debugging "secure
# session cookie not set on HTTPS".
